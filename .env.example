# ========================
# LostIntoSpacE Environment Variables
# Copy this to .env and fill in values
# ========================

# ---------- General ----------
APP_ENV=development
DEBUG=true
LOG_LEVEL=info

# ---------- Frontend ----------
# Leave unset for local development: the Vite dev server proxies /api to the
# backend, so the client uses a relative URL and no CORS negotiation happens.
# Set this only when the frontend is served from a different origin than the
# API, and add that origin to CORS_ORIGINS above.
# VITE_API_URL=http://localhost:8000/api/v1

# ---------- Backend ----------
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated list of origins allowed to call the API.
# Port 3000 is what apps/web/vite.config.ts serves on. In development the
# Vite proxy makes API calls same-origin so CORS is not exercised at all;
# this matters when the frontend is served from a different origin.
CORS_ORIGINS=http://localhost:3000

# ---------- Database ----------
# PostgreSQL 13+ required (gen_random_uuid in core, STORED generated columns).
# Both the app and Alembic use the asyncpg driver - see docs/backend/DATABASE_SETUP.md
DATABASE_URL=postgresql+asyncpg://lostintospace:password@localhost:5432/lostintospace
DATABASE_ECHO=false
# Separate database for the test suite, so tests can never touch dev data.
# Tests needing a live server SKIP when this is unset.
# TEST_DATABASE_URL=postgresql+asyncpg://lostintospace:password@localhost:5432/lostintospace_test

# ---------- Redis (Optional) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- External APIs ----------
NASA_API_KEY=DEMO_KEY
# OPENWEATHER_API_KEY=

# ---------- AI Provider ----------
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# ---------- Storage ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
