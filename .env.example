# ========================
# LostIntoSpacE Environment Variables
# Copy this to .env and fill in values
# ========================

# ---------- General ----------
APP_ENV=development
DEBUG=true
LOG_LEVEL=info

# ---------- Frontend ----------
# Leave unset for local development: the Vite dev server proxies /api to the
# backend, so the client uses a relative URL and no CORS negotiation happens.
# Set this only when the frontend is served from a different origin than the
# API, and add that origin to CORS_ORIGINS above.
# VITE_API_URL=http://localhost:8000/api/v1

# ---------- Backend ----------
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated list of origins allowed to call the API.
# Port 3000 is what apps/web/vite.config.ts serves on. In development the
# Vite proxy makes API calls same-origin so CORS is not exercised at all;
# this matters when the frontend is served from a different origin.
CORS_ORIGINS=http://localhost:3000

# ---------- Database ----------
# PostgreSQL 13+ required (gen_random_uuid in core, STORED generated columns).
# Both the app and Alembic use the asyncpg driver - see docs/backend/DATABASE_SETUP.md
# `scripts/dev/stack.sh` runs a cluster owned by your own user on 5433, which
# needs no sudo and cannot collide with a system PostgreSQL on 5432.
DATABASE_URL=postgresql+asyncpg://lostintospace:lostintospace@127.0.0.1:5433/lostintospace
DATABASE_ECHO=false
# Separate database for the test suite, so tests can never touch dev data.
# Tests needing a live server SKIP when this is unset.
# TEST_# `scripts/dev/stack.sh` runs a cluster owned by your own user on 5433, which
# needs no sudo and cannot collide with a system PostgreSQL on 5432.
DATABASE_URL=postgresql+asyncpg://lostintospace:lostintospace@127.0.0.1:5433/lostintospace_test

# ---------- Redis (Optional) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- External APIs ----------
NASA_API_KEY=DEMO_KEY
# OPENWEATHER_API_KEY=

# ---------- AI Provider ----------
# With no key configured the assistant falls back to an extractive provider
# that quotes retrieved evidence rather than generating prose. That is a real,
# honest degradation - grounded but terse - not an outage.
#
# Set a Gemini key and it is selected automatically. LIS_AI_PROVIDER overrides
# the choice; valid values are gemini, extractive and mock.
# GEMINI_API_KEY=
# LIS_AI_PROVIDER=gemini
#
# Leave GEMINI_MODEL unset to use the provider's fallback chain, which tries
# several models in order - the API returns 503 for individual overloaded
# models fairly often, and falling through turns that into a slower answer
# rather than a failed one. Set it to pin one model.
# GEMINI_MODEL=gemini-3.5-flash
#
# Thinking tokens come out of the same budget as the answer, so they are
# disabled by default. Set a token count to re-enable extended reasoning.
# GEMINI_THINKING_BUDGET=0

# ---------- Storage ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
